# Leave PREDICTION_API_URL empty to use the embedded Pima logistic model.
PREDICTION_API_URL=

# Optional authentication for your external prediction provider.
PREDICTION_API_KEY=
PREDICTION_API_KEY_HEADER=Authorization
PREDICTION_API_KEY_PREFIX=Bearer

# Timeout in milliseconds for the external prediction request.
PREDICTION_API_TIMEOUT_MS=8000

# When set, each completed assessment (inputs + model result) is stored in collection "risk_assessments"
# in the database below (or the default DB from the URI if you omit the name).
# Example: mongodb+srv://user:pass@cluster.example.net/diabete?retryWrites=true&w=majority
MONGODB_URI=
# If your URI has no database path (e.g. ends with .net/), set the database name explicitly:
# MONGODB_DB_NAME=diabete
# Rare: set to 1 if you must use an older Atlas that breaks with Stable API v1 (TLS/selection issues are usually fixed by Atlas network access + this app’s default client options).
# MONGODB_DISABLE_STABLE_API=1

# Required for GET /api/exports/risk-assessments-csv — pass the same value as ?token= or X-Export-Token or Authorization: Bearer
RISK_CSV_EXPORT_TOKEN=
